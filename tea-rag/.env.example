# ===================== 复制本文件为 .env 并填入真实密钥 =====================
# Windows 下：copy .env.example .env

# ===== LLM 生成模型（DeepSeek）=====
# 官方平台申请 Key：https://platform.deepseek.com
# DeepSeek 是 OpenAI 兼容协议，base_url 填官方地址即可
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-你的deepseek密钥
LLM_MODEL=deepseek-chat

# ===== Embedding 向量模型（推荐 SiliconFlow 上的 bge-m3，中文最强之一）=====
# 申请地址：https://siliconflow.cn （有免费额度，OpenAI 兼容协议）
# 说明：DeepSeek 官方不提供 Embedding，所以向量模型需要单独选
# 想切换本地 bge-m3 / 通义，见 README「切换向量模型」一节
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-你的siliconflow密钥
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 向量库（本地 Chroma）=====
CHROMA_DIR=./chroma_db
COLLECTION_NAME=tea_knowledge

# ===== 切块参数（国标条款式文本建议 800 / 200，保证一个定义段不被切断）=====
CHUNK_SIZE=800
CHUNK_OVERLAP=200

# ===== 检索参数 =====
TOP_K=4
